# Copiar a .env (no se sube a Git) y completar los dos secretos.
# Generar valores con, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=onlinejudge
POSTGRES_USER=onlinejudge
POSTGRES_PASSWORD=
# Al menos 32 caracteres.
JUDGE_SERVER_TOKEN=

# Puerto público de la interfaz (http://localhost por defecto).
OJ_HTTP_PORT=80
# 127.0.0.1 para que solo se acceda desde este equipo.
OJ_HTTP_BIND=0.0.0.0

# Dominio propio: añadirlo a los hosts y, si va con HTTPS, a los orígenes de confianza.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,oj-backend
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 cuando el sitio se sirve por HTTPS.
COOKIE_SECURE=0
# 1 solo si un proxy propio termina TLS y envía X-Forwarded-Proto.
TRUST_PROXY_HTTPS=0
MAX_WORKER_NUM=2

# Tutor con modelo (solo con compose.tutor.yml).
MODEL_THREADS=4
MODEL_TIMEOUT_S=25
SUGGEST_TIMEOUT_S=90
AI_TUTOR_ENGINE_TIMEOUT=30
AI_TUTOR_SUGGEST_TIMEOUT=100
